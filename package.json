{
  "name": "cmd-palette",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38",
  "scripts": {
    "dev": "vite",
    "browserlist": "browserslist",
    "browserslist:lint": "browserslist-lint",
    "build": "tsc && vite build",
    "lint": "pnpm run lint:css && pnpm run lint:es && pnpm run lint:markup && pnpm run lint:prettier && pnpm run lint:types",
    "lint:fix": "pnpm run lint:css-fix && pnpm run lint:es-fix && pnpm run lint:markup-fix && pnpm run lint:prettier-fix",
    "lint:css": "stylelint src/**/*.{module.css,css}",
    "lint:css-fix": "stylelint src/**/*.{module.css,css} --fix",
    "lint:es": "oxlint ./src ./scripts --deny-warnings",
    "lint:es-fix": "oxlint ./src ./scripts --deny-warnings --fix",
    "lint:markup": "markuplint src/**/*.{html,jsx,tsx}",
    "lint:markup-fix": "markuplint src/**/*.{html,jsx,tsx} --fix",
    "lint:prettier": "prettier --check src/**/*.{ts,tsx,js,jsx,json,css,md}",
    "lint:prettier-fix": "prettier --write src/**/*.{ts,tsx,js,jsx,json,css,md}",
    "lint:types": "tsc --noEmit",
    "test": "vitest --passWithNoTests",
    "test:playwright": "playwright test",
    "test:playwright-ui": "playwright test --ui",
    "prepare": "husky",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "es-toolkit": "^1.52.0",
    "lucide-react": "^0.468.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@markuplint/jsx-parser": "^4.18.0",
    "@markuplint/react-spec": "^4.18.0",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-mcp": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "browserslist": "^4.28.2",
    "browserslist-lint": "^0.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.3",
    "markuplint": "^4.18.1",
    "oxlint": "^1.63.0",
    "playwright": "latest",
    "prettier": "^3.8.3",
    "storybook": "^10.6.2",
    "stylelint": "^17.11.0",
    "stylelint-config-alphabetical-order": "^2.0.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "stylelint-order": "^8.1.1",
    "stylelint-plugin-defensive-css": "^2.9.1",
    "stylelint-selector-bem-pattern": "^4.0.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  }
}
